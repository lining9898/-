{
  "id": "staircase-plate",
  "name": "现浇板式楼梯",
  "kind": "calculation",
  "version": "1.0.0",
  "description": "单跨简支板式楼梯（水平投影折算）的恒载、活载、荷载组合、内力、配筋与构造验算，返回 CalculationResult。",
  "component": "staircase",
  "calculatorEntry": "./calculator.ts",
  "legacyEntry": "../../src/core/stair/plate.ts",
  "inputSchema": "./schema.json",
  "evidenceCatalog": "./evidence.json",
  "testCatalog": "./tests.json",
  "outputType": "src/types/calculation.ts#CalculationResult",
  "applicability": [
    "单跨简支现浇板式楼梯（取 1m 宽梯板）",
    "梯段自重按水平投影折算（斜板 + 踏步三角形）",
    "未计梯梁弹性支承与斜板受扭"
  ],
  "boundaryChecks": [
    "相对受压区高度 ξ 与 ξb",
    "最小配筋率 ρmin",
    "实配钢筋面积与所需面积",
    "受弯承载力 Mu 与设计弯矩 M",
    "钢筋间距 70~200mm 构造",
    "梯板厚度构造建议",
    "梯板、踏步和荷载输入边界"
  ],
  "formulaMappings": [
    {
      "id": "dead-load",
      "expression": "gk = 25*t*sqrt(1+(h/b)^2) + 25*h/2 + gkExtra",
      "evidenceId": "clause-gb50009-weight",
      "requiredInputFields": ["t", "stepRise", "stepRun", "gkExtra"]
    },
    {
      "id": "load-combination",
      "expression": "q = (gammaG*gk + gammaQ*qk)*b",
      "evidenceId": "clause-gb50009-combo",
      "requiredInputFields": ["span", "stepRise", "stepRun", "t", "gkExtra", "qk", "gammaG", "gammaQ", "width"]
    },
    {
      "id": "midspan-moment",
      "expression": "M = q*l0^2/8",
      "evidenceId": "clause-moment",
      "requiredInputFields": ["span"]
    },
    {
      "id": "flexure-design",
      "expression": "As_req = alpha1*fc*b*x/fy",
      "evidenceId": "clause-6.2.10",
      "requiredInputFields": ["t", "concreteGrade", "steelGrade", "cover", "barDiameter"]
    },
    {
      "id": "minimum-reinforcement-ratio",
      "expression": "rhoMin = max(0.20, 45*ft/fy)/100",
      "evidenceId": "clause-8.5.1",
      "requiredInputFields": ["t", "concreteGrade", "steelGrade"]
    }
  ],
  "status": "REVIEW_REQUIRED",
  "supportedUnits": ["mm", "m", "mm²/m", "kN/m", "kN/m²", "kN·m", "MPa", "%", "grade", "dimensionless"]
}
