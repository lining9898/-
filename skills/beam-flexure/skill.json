{
  "id": "beam-flexure",
  "name": "矩形梁正截面受弯",
  "kind": "calculation",
  "version": "1.0.0",
  "description": "计算矩形普通钢筋混凝土梁、无受压钢筋和无预应力筋简化条件下的正截面受弯承载力，并返回 CalculationResult。",
  "component": "beam",
  "calculatorEntry": "./calculator.ts",
  "legacyEntry": "../../src/core/beam/flexure.ts",
  "inputSchema": "./schema.json",
  "evidenceCatalog": "./evidence.json",
  "testCatalog": "./tests.json",
  "outputType": "src/types/calculation.ts#CalculationResult",
  "applicability": [
    "矩形截面普通钢筋混凝土梁",
    "单向受弯、无受压钢筋、无预应力筋的简化正截面承载力计算",
    "输入弯矩为设计值，结果仅覆盖登记的单项验算"
  ],
  "boundaryChecks": [
    "相对受压区高度 xi 与界限值 xiB",
    "最小配筋面积 AsMin = rhoMin * b * h",
    "受弯承载力 Mu 与设计弯矩 M",
    "钢筋根数、直径、保护层和截面容纳条件",
    "弯矩为零、材料等级未知和钢筋放不下等输入边界"
  ],
  "formulaMappings": [
    {
      "id": "compression-zone-depth",
      "expression": "x = fy * As / (alpha1 * fc * b)",
      "evidenceId": "clause-6.2.10-x",
      "requiredInputFields": ["b", "concreteGrade", "steelGrade", "barDiameter", "barCount"]
    },
    {
      "id": "relative-compression-depth",
      "expression": "xi = x / h0",
      "evidenceId": "clause-6.2.10-xi",
      "requiredInputFields": ["h", "cover", "barDiameter"]
    },
    {
      "id": "limiting-relative-depth",
      "expression": "xiB = beta1 / (1 + fy / (Es * epsilonCu))",
      "evidenceId": "clause-6.2.7",
      "requiredInputFields": ["concreteGrade", "steelGrade"]
    },
    {
      "id": "flexural-capacity",
      "expression": "Mu = alpha1 * fc * b * x * (h0 - x / 2) / 1e6",
      "evidenceId": "clause-6.2.10-Mu",
      "requiredInputFields": ["b", "h", "cover", "barDiameter", "barCount", "concreteGrade", "steelGrade"]
    },
    {
      "id": "minimum-reinforcement-ratio",
      "expression": "rhoMin = max(0.20%, 45 * ft / fy %)",
      "evidenceId": "clause-8.5.1-rho",
      "requiredInputFields": ["concreteGrade", "steelGrade"]
    },
    {
      "id": "minimum-reinforcement-area",
      "expression": "AsMin = rhoMin * b * h",
      "evidenceId": "clause-8.5.1-area",
      "requiredInputFields": ["b", "h", "concreteGrade", "steelGrade"]
    }
  ],
  "status": "REVIEW_REQUIRED",
  "supportedUnits": ["mm", "mm²", "kN·m", "MPa", "%", "根", "grade", "dimensionless"]
}
