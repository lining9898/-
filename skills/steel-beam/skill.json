{
  "id": "steel-beam",
  "name": "对称工字形钢梁三项验算",
  "kind": "calculation",
  "version": "1.0.0",
  "description": "计算对称工字形钢梁毛截面特性，并进行受弯、受剪与整体稳定三项验算；材料强度和稳定系数由用户提供，结果保持 REVIEW_REQUIRED。",
  "component": "steel",
  "calculatorEntry": "./calculator.ts",
  "legacyEntry": "../../src/core/steel/beam.ts",
  "inputSchema": "./schema.json",
  "evidenceCatalog": "./evidence.json",
  "testCatalog": "./tests.json",
  "outputType": "src/types/calculation.ts#CalculationResult",
  "applicability": [
    "等厚双翼缘、腹板居中的对称工字形截面",
    "绕强轴单向受弯，输入弯矩和剪力均为设计值",
    "f、fv和φb由用户根据钢号、厚度及侧向支承条件另行确定"
  ],
  "boundaryChecks": [
    "截面几何必须满足h>2tf且bf>tw",
    "受弯应力不大于用户输入的抗弯强度设计值",
    "受剪应力不大于用户输入的抗剪强度设计值",
    "整体稳定应力不大于用户输入的抗弯强度设计值",
    "未覆盖宽厚比、局部稳定、挠度、疲劳、连接、防火和抗震"
  ],
  "formulaMappings": [
    {
      "id": "bending-strength",
      "expression": "sigma = M / W",
      "evidenceId": "clause-6.1.1",
      "requiredInputFields": ["h", "bf", "tf", "tw", "moment", "bendingStrength"]
    },
    {
      "id": "shear-strength",
      "expression": "tau = V * S / (I * tw)",
      "evidenceId": "clause-6.1.3",
      "requiredInputFields": ["h", "bf", "tf", "tw", "shear", "shearStrength"]
    },
    {
      "id": "overall-stability",
      "expression": "sigmaB = M / (phiB * W)",
      "evidenceId": "clause-6.2.2",
      "requiredInputFields": ["h", "bf", "tf", "tw", "moment", "bendingStrength", "stabilityFactor"]
    }
  ],
  "status": "REVIEW_REQUIRED",
  "supportedUnits": ["mm", "mm²", "mm³", "mm⁴", "kN", "kN·m", "N/mm²", "dimensionless"]
}
